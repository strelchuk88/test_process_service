# Application (inside docker the hosts are the compose service names)
DB__URL=postgresql+asyncpg://postgres:postgres@postgres:5432/payments
RABBIT__URL=amqp://guest:guest@rabbitmq:5672/
API_KEY=super-secret-api-key
DEBUG=True

# Optional overrides (defaults shown)
# RABBIT__MAX_ATTEMPTS=3
# RABBIT__RETRY_BASE_DELAY=2.0
# OUTBOX__POLL_INTERVAL=1.0
# OUTBOX__BATCH_SIZE=100
# GATEWAY__MIN_DELAY=2.0
# GATEWAY__MAX_DELAY=5.0
# GATEWAY__SUCCESS_RATE=0.9
# WEBHOOK__TIMEOUT=10.0

# docker compose
DB_PORT=5432
DB_NAME=payments
DB_USER=postgres
DB_PASSWORD=postgres
WEB_PORT=8000
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_PORT=5672
RABBIT_UI_PORT=15672
WEBHOOK_MOCK_PORT=9000
